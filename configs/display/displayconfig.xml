    <highBrightnessMode enabled="true">
        <transitionPoint>0.85</transitionPoint>
        <minimumLux>10000</minimumLux>
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0.05</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.000</sdrNits>
                <hdrRatio>4.000</hdrRatio>
            </point>
            <point>
                <sdrNits>10.000</sdrNits>
                <hdrRatio>6.000</hdrRatio>
            </point>
