                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>150</threshold><percentage>25</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>500</threshold><percentage>25</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </brighteningThresholds>
        <darkeningThresholds>
