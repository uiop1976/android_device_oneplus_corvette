            </point>
            <point>
                <sdrNits>1600.000</sdrNits>
                <hdrRatio>1.000</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>2</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0</threshold><percentage>15</percentage>
                </brightnessThresholdPoint>
