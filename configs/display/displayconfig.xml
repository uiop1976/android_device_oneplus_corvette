<?xml version="1.0" encoding="UTF-8"?>
<!--
     OnePlus Ace 3 Pro (corvette) Display & UltraHDR Configuration
     Panel: BOE X1 (AA567 P 3 A0004 dsc cmd mode panel)
     Hardware Normal Max DBV: 3332 (~800 nits)
     Hardware HBM / HDR Max DBV: 4094 (~1600 nits)
     Note: Dense piecewise-collinear points ensure MonotoneCubicSpline in
           PhysicalMappingStrategy has exact linear tangents (zero round-trip distortion).
-->
<displayConfiguration>
    <lightSensor>
        <type>android.sensor.light</type>
        <name>Oplus FusionLight Sensor</name>
    </lightSensor>

